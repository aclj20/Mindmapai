# ── AWS S3 ────────────────────────────────────────────────────────────────────
# Credenciales IAM con permisos s3:PutObject y s3:DeleteObject sobre el bucket
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_bucket_name_here


S3_PUBLIC_URL=https://your_bucket_name_here.s3.us-east-1.amazonaws.com

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret

# ── Groq (generación de mapas con IA) ────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Email (verificación de cuentas) ──────────────────────────────────────────
# Genérala en: https://myaccount.google.com/apppasswords
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx
